---
// Breadcrumb aware of Astro `base` (GitHub Pages: /marcoschipani.github.io)
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

let pathOnly = Astro.url.pathname.replace(/\/+$/, "");
if (base && pathOnly.startsWith(base)) {
  pathOnly = pathOnly.slice(base.length) || "";
}

// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = pathOnly.split("/").filter(Boolean);

// if breadcrumb is Home > Posts > 1 <etc>
// replace Posts with Posts (page number)
if (breadcrumbList[0] === "posts" && breadcrumbList.length >= 1) {
  const pageNum = breadcrumbList[1];
  if (pageNum && !Number.isNaN(Number(pageNum))) {
    breadcrumbList.splice(0, 2, `Posts (page ${pageNum || 1})`);
  }
}

// if breadcrumb is Home > Tags > [tag] > [page] <etc>
// replace [tag] > [page] with [tag] (page number)
if (breadcrumbList[0] === "tags" && !isNaN(Number(breadcrumbList[2]))) {
  breadcrumbList.splice(
    1,
    3,
    `${breadcrumbList[1]} ${Number(breadcrumbList[2]) === 1 ? "" : "(page " + breadcrumbList[2] + ")"}`
  );
}

const homeHref = `${base}/`;

function crumbHref(index: number) {
  const segments = breadcrumbList.slice(0, index + 1);
  // numbered "Posts (page N)" is not a real path segment — skip linking mid-post list
  if (segments[0]?.startsWith("Posts (page")) {
    return `${base}/posts/`;
  }
  return `${base}/${segments.join("/")}/`;
}
---

<nav class="app-layout mt-8 mb-1" aria-label="breadcrumb">
  <ul
    class="font-light [&>li]:inline [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li>
      <a href={homeHref} class="opacity-80">Home</a>
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      breadcrumbList.map((breadcrumb, index) =>
        index + 1 === breadcrumbList.length ? (
          <li>
            <span
              class:list={["capitalize opacity-75", { lowercase: index > 0 }]}
              aria-current="page"
            >
              {decodeURIComponent(breadcrumb)}
            </span>
          </li>
        ) : (
          <li>
            <a href={crumbHref(index)} class="capitalize opacity-70">
              {breadcrumb}
            </a>
            <span aria-hidden="true">&raquo;</span>
          </li>
        )
      )
    }
  </ul>
</nav>
