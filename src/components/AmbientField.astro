---
interface Props {
  variant: "birds" | "voronoi";
}

const { variant } = Astro.props;
---

{
  variant === "voronoi" ? (
    <canvas class="ambient-field" data-ambient="voronoi" aria-hidden="true"></canvas>
  ) : (
    <div class="ambient-field" data-ambient="birds" aria-hidden="true"></div>
  )
}
<script>
  import "@/scripts/ambient-field";
</script>
