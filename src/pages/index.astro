---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeUrl = base ? `${base}/` : "/";
const postsUrl = `${base}/posts/`;
const beyondShocksUrl = `${base}/posts/beyond-the-shocks-2d-reconstruction/`;
const sentinelUrl = `${base}/projects/sentinel/`;
const eyLogoUrl = `${base}/EYlogo.svg`;
const galloUrl = `${base}/gallo.png`;
const dijonUrl = `${base}/Dijon.svg`;
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-8 pb-6"]}>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Hi, I'm Marco
      </h1>

      <p class="max-w-2xl text-base md:text-lg leading-relaxed text-foreground/70">
        MSc Mathematics · SOC Analyst @ EY Málaga · building
        <strong class="text-foreground">Fraud &amp; Anomaly Detection</strong> ML
      </p>

      <div class="mt-4 min-h-[1.5em] text-xl md:text-2xl font-bold tracking-tight text-accent">
        <span id="typewriter"></span>
        <span
          id="cursor"
          class="ml-1 border-l-2 border-accent animate-pulse"
        ></span>
      </div>

      {
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
            <Socials />
          </div>
        )
      }

      <p class="mt-4 text-sm md:text-base text-foreground/60">
        Featured project:{" "}
        <a
          href={sentinelUrl}
          class="text-accent underline-offset-4 hover:underline"
        >
          Sentinel — fraud risk-scoring platform
        </a>
      </p>
    </section>

    <section id="experience" class="pt-10 pb-6 border-b border-border/50">
      <h2 class="text-2xl font-semibold tracking-wide">Experience</h2>

      <div class="mt-8 space-y-10">
        {/* EY */}
        <div class="flex flex-col gap-1">
          <div class="flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div
                class="flex h-8 w-8 items-center justify-center rounded bg-white p-1"
              >
                <img
                  src={eyLogoUrl}
                  alt="EY"
                  class="h-full w-full object-contain"
                />
              </div>
              <span class="text-xl font-bold">EY</span>
            </div>
            <span class="text-sm font-mono opacity-50 shrink-0"
              >Sep 2025 — Present</span
            >
          </div>
          <p class="text-lg italic tracking-tight">
            SOC Analyst — Detection Engineering &amp; Security Analytics
          </p>
          <p
            class="text-base md:text-lg leading-relaxed text-foreground/70 max-w-2xl"
          >
            Detection engineering in the SOC: Azure Sentinel Workbooks and KQL
            on high-volume security telemetry, Logic Apps playbooks for
            enrichment and risk-based escalation, and Python/Bash pipelines to
            normalize multi-source logs. Focus on cutting triage time and
            false-positive noise with statistical anomaly workflows — bridging
            security operations toward applied ML for fraud and anomaly
            detection.
          </p>
        </div>

        {/* Valencia */}
        <div class="flex flex-col gap-1 border-t border-border/50 pt-8">
          <div class="flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div
                class="flex h-8 w-8 items-center justify-center rounded bg-white p-1"
              >
                <img
                  src={galloUrl}
                  alt="Universitat de València"
                  class="h-full w-full object-contain"
                />
              </div>
              <span class="text-xl font-bold">Universitat de València</span>
            </div>
            <span class="text-sm font-mono opacity-50 shrink-0"
              >2023 — 2024</span
            >
          </div>
          <p class="text-lg italic tracking-tight">Research Student</p>
          <p
            class="text-base md:text-lg leading-relaxed text-foreground/70 max-w-2xl"
          >
            Research on monotone-preserving cubic/bicubic Hermite interpolants
            for geometric constraint preservation, with new numerical methods
            for the bidimensional case (
            <a
              href={beyondShocksUrl}
              class="!text-accent underline decoration-dashed underline-offset-4 hover:!text-accent/80"
            >
              forthcoming publication track
            </a>).
          </p>
        </div>

        {/* Dijon */}
        <div class="flex flex-col gap-1 border-t border-border/50 pt-8">
          <div class="flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded bg-white p-1 overflow-hidden"
              >
                <img
                  src={dijonUrl}
                  alt="Université de Bourgogne"
                  class="max-h-full w-auto object-contain"
                />
              </div>
              <span class="text-xl font-bold">Université de Bourgogne</span>
            </div>
            <span class="text-sm font-mono opacity-50 shrink-0"
              >May 2021 — Aug 2021</span
            >
          </div>
          <p class="text-lg italic tracking-tight">Research Student</p>
          <p
            class="text-base md:text-lg leading-relaxed text-foreground/70 max-w-2xl"
          >
            Quantitative graph theory: free-group structure via Cayley graphs,
            combinatorial pattern recognition, and analysis of invariant /
            symmetry structures.
          </p>
        </div>
      </div>
    </section>

    <section id="skills" class="pt-10 pb-6 border-b border-border/50">
      <h2 class="text-2xl font-semibold tracking-wide">Skills</h2>

      <div class="mt-6 flex flex-wrap gap-3">
        {
          [
            "Fraud & Anomaly Detection",
            "Imbalanced Learning",
            "Statistical Learning",
            "Detection Engineering",
            "KQL / Azure Sentinel",
            "Python",
            "FastAPI · Docker · MLflow",
            "SQL / PostgreSQL",
          ].map((label) => (
            <div class="px-4 py-2 border border-border/50 bg-muted/30 rounded-md hover:border-accent/50 transition-colors">
              <span class="font-sans text-sm font-bold">{label}</span>
            </div>
          ))
        }
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
          <ul>
            {featuredPosts.map((data) => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    {
      sortedPosts.length > 0 && (
        <div class="my-8 text-center">
          <LinkButton href={postsUrl}>
            All Posts
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>

<script is:inline define:vars={{ homeUrl }}>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = document.querySelector("#main-content")?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", homeUrl);
    }
  });
</script>

<script>
  let typewriterTimer: ReturnType<typeof setTimeout> | undefined;

  function initTypewriter() {
    if (typewriterTimer) clearTimeout(typewriterTimer);

    const textElement = document.getElementById("typewriter");
    if (!textElement) return;

    const phrases = [
      "Fraud & anomaly detection, end to end.",
      "Detection engineering meets applied ML.",
      "Math foundations, production-minded systems.",
      "I care about recall, not vanity accuracy.",
    ];

    let phraseIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    let typeSpeed = 100;

    function type() {
      const currentElement = document.getElementById("typewriter");
      if (!currentElement) return;

      const currentPhrase = phrases[phraseIndex];

      if (isDeleting) {
        currentElement.textContent = currentPhrase.substring(0, charIndex - 1);
        charIndex--;
        typeSpeed = 50;
      } else {
        currentElement.textContent = currentPhrase.substring(0, charIndex + 1);
        charIndex++;
        typeSpeed = 100;
      }

      if (!isDeleting && charIndex === currentPhrase.length) {
        isDeleting = true;
        typeSpeed = 2000;
      } else if (isDeleting && charIndex === 0) {
        isDeleting = false;
        phraseIndex = (phraseIndex + 1) % phrases.length;
        typeSpeed = 500;
      }

      typewriterTimer = setTimeout(type, typeSpeed);
    }

    type();
  }

  document.addEventListener("astro:page-load", initTypewriter);
</script>
