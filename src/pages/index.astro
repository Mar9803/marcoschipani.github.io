---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { CHAPTERS } from "@/constants/chapters";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeUrl = base ? `${base}/` : "/";
const href = (path: string) => `${base}${path}`.replace(/\/+/g, "/");

const cards = [
  ...CHAPTERS.map(chapter => ({
    href: href(`/${chapter.id}/`),
    kicker: chapter.kicker,
    title: chapter.title,
    line: chapter.card,
  })),
  {
    href: href("/projects/sentinel/"),
    kicker: "Lab",
    title: "SentinelGraph",
    line: "Anti-fraud lab: rules, XGBoost, and an autoencoder, in real time.",
  },
];
---

<Layout>
  <Header wide />
  <main id="main-content" data-layout="index" class="chapter-page mx-auto w-full max-w-5xl px-4 pb-16">
    <section id="hero" class="pt-8 pb-8">
      <h1 class="my-4 text-4xl font-bold tracking-tight sm:my-8 sm:text-5xl">
        Hi, I'm Marco
      </h1>

      <p class="max-w-2xl text-base leading-relaxed text-foreground/70 md:text-lg">
        MSc Mathematics · SOC Analyst @ EY Málaga · building
        <strong class="text-foreground">Fraud &amp; Anomaly Detection</strong> ML
      </p>

      <div class="mt-4 min-h-[1.5em] text-xl font-bold tracking-tight text-foreground/70 md:text-2xl">
        <span id="typewriter"></span>
        <span
          id="cursor"
          class="ml-1 border-l-2 border-foreground/70 animate-pulse"
        ></span>
      </div>
    </section>

    <ul class="grid gap-4 sm:grid-cols-2">
      {
        cards.map(card => (
          <li>
            <a href={card.href} class="glass-card">
              <span class="text-sm font-medium text-foreground/70">{card.kicker}</span>
              <span class="text-xl font-medium leading-snug">{card.title}</span>
              <span class="text-sm leading-relaxed text-foreground/70">{card.line}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
  <Footer />
</Layout>

<script is:inline define:vars={{ homeUrl }}>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = document.querySelector("#main-content")?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", homeUrl);
    }
  });
</script>

<script>
  let typewriterTimer: ReturnType<typeof setTimeout> | undefined;

  function initTypewriter() {
    if (typewriterTimer) clearTimeout(typewriterTimer);

    const textElement = document.getElementById("typewriter");
    if (!textElement) return;

    const phrases = [
      "Fraud & anomaly detection, end to end.",
      "Detection engineering meets applied ML.",
      "Math foundations, production-minded systems.",
      "I care about recall, not vanity accuracy.",
    ];

    let phraseIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    let typeSpeed = 100;

    function type() {
      const currentElement = document.getElementById("typewriter");
      if (!currentElement) return;

      const currentPhrase = phrases[phraseIndex];

      if (isDeleting) {
        currentElement.textContent = currentPhrase.substring(0, charIndex - 1);
        charIndex--;
        typeSpeed = 50;
      } else {
        currentElement.textContent = currentPhrase.substring(0, charIndex + 1);
        charIndex++;
        typeSpeed = 100;
      }

      if (!isDeleting && charIndex === currentPhrase.length) {
        isDeleting = true;
        typeSpeed = 2000;
      } else if (isDeleting && charIndex === 0) {
        isDeleting = false;
        phraseIndex = (phraseIndex + 1) % phrases.length;
        typeSpeed = 500;
      }

      typewriterTimer = setTimeout(type, typeSpeed);
    }

    type();
  }

  document.addEventListener("astro:page-load", initTypewriter);
</script>
